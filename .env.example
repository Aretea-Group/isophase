# Mock Sentinel REST facade (apps/mock-sentinel)
PORT=8787
HOST=0.0.0.0
SERVICE_VERSION=0.0.0-dev
LOG_LEVEL=info

# Kusto Emulator — INTERNAL dependency of Mock Sentinel.
# No consumer outside apps/mock-sentinel may talk to this endpoint (PRD-1 §7).
KUSTO_ENDPOINT=http://localhost:8080
KUSTO_PORT=8080
KUSTO_DATABASE=SentinelLab
KUSTO_TIMEOUT_MS=30000

# Upper bound on rows returned by POST /query before truncation is reported.
QUERY_MAX_ROWS=500

# --- Investigator (apps/investigator, PRD-2) ---------------------------------
# Validated at startup by apps/investigator/src/env.ts, so a missing required key
# stops the process before the first alert is fetched.

# Sentinel capability. Mock is the zero-credential default.
SENTINEL_CONNECTOR=mock
SENTINEL_BASE_URL=http://localhost:8787
SENTINEL_TIMEOUT_MS=30000

# Real Microsoft Sentinel through Azure Monitor Logs. Workspace ID is required
# when SENTINEL_CONNECTOR=azure. Set all three service-principal values, or omit
# all three and sign in first with `az login` or `Connect-AzAccount`. Use the
# Workspace ID (GUID), not its display name. Workspace shared keys cannot query.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_LOG_ANALYTICS_WORKSPACE_ID=

# Microsoft Defender XDR through the Microsoft Graph security API.
# All three are required together; a partial group is a configuration error and
# never falls back to another identity. The app registration needs the Graph
# application permissions SecurityAlert.Read.All and ThreatHunting.Read.All,
# with admin consent granted — without consent a token is still issued but
# carries no roles and every call returns 403. See docs/defender-setup.md.
# Developer sign-in (az login / Connect-AzAccount) is NOT a verified path here.
# DEFENDER_TENANT_ID=
# DEFENDER_CLIENT_ID=
# DEFENDER_CLIENT_SECRET=
# Optional. Targets one Log Analytics workspace onboarded into the Defender
# portal; omitted, the service uses the caller's primary workspace. Measured
# against a real tenant: a workspace id no tenant owns is accepted with HTTP 200
# and silently answered from the primary workspace, so a typo here looks exactly
# like success. Leave it unset unless you know you need it.
# DEFENDER_WORKSPACE_ID=

# Which security sources this run selects, in order. Defaults to sentinel so a
# zero-credential checkout keeps working against Mock Sentinel. Standalone
# Defender is SECURITY_SOURCES=defender and needs no Sentinel credential, no
# workspace id and no Mock Sentinel process. Exactly one id for now; several
# active sources with one primary alert producer is PRD-8 Phase 2.
SECURITY_SOURCES=sentinel
# Required when SECURITY_SOURCES contains more than one id; otherwise defaults to the sole id.
# PRIMARY_ALERT_SOURCE=sentinel

# Per-request timeout, matching SENTINEL_TIMEOUT_MS.
DEFENDER_TIMEOUT_MS=30000
# Row cap pushed into the query text. A fetch-cost bound, not an evidence bound:
# INVESTIGATOR_RESULT_MAX_CHARS below is what limits how much reaches the model,
# and it stays source-neutral. The widest table measured (CloudAppEvents)
# serialises at ~5,000 characters per whole row, so the character budget binds
# first for any realistic projection.
DEFENDER_QUERY_MAX_ROWS=500
# ISO 8601 duration bounding the alert queue. alerts_v2 supports no $orderby, so
# "the newest 500" is not expressible and a window is; more than 500 alerts in
# the window is refused rather than silently truncated.
DEFENDER_ALERT_WINDOW=P7D
# Gates the live Defender smoke test, matching AZURE_SENTINEL_LIVE_TEST.
# DEFENDER_LIVE_TEST=true

# Provider/model for the investigation agent. Registered providers: openai,
# anthropic, google, plus llamacpp when the complete endpoint group below is set.
# Override per run, e.g.
#   INVESTIGATOR_MODEL=gpt-5.6-sol bun run investigate --alert <id>
INVESTIGATOR_PROVIDER=openai
INVESTIGATOR_MODEL=gpt-5.6-luna
INVESTIGATOR_THINKING_LEVEL=medium

# One llama-server model exposed through its OpenAI-compatible API. Supply all
# four endpoint values or none. The URL must be absolute and end in /v1. Reasoning
# defaults off; use binary for an off/on model or effort for a model supporting
# none/low/medium/xhigh reasoning_effort. Bearer authentication is optional;
# omit the token for a keyless endpoint.
# LLAMA_SERVER_BASE_URL=https://host.example/v1
# LLAMA_SERVER_MODEL=local-model
# LLAMA_SERVER_CONTEXT_WINDOW=65536
# LLAMA_SERVER_MAX_TOKENS=4096
# LLAMA_SERVER_REASONING_PROFILE=off
# LLAMA_SERVER_BEARER_TOKEN=...

# Runtime guardrails, not investigation logic (PRD-2 §17).
INVESTIGATOR_MAX_TURNS=50
INVESTIGATOR_TIMEOUT_MS=1200000

# Read by pi-ai from the ambient environment. Set the one matching your provider.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Public web research. Without BRAVE_API_KEY the agent still investigates on
# telemetry alone; web_search simply fails as a recoverable tool error.
BRAVE_API_KEY=
BRAVE_TIMEOUT_MS=15000
BRAVE_RESULT_COUNT=10
WEB_FETCH_TIMEOUT_MS=20000

# Where run artifacts are written. Azure runs must use an ignored .data/ path,
# for example .data/azure-runs, because they can contain tenant data.
RUNS_DIR=runs
# Analyst classifications; separate because they are not reproducible scratch data.
FEEDBACK_DIR=feedback

# Capture the full Pi transcript per investigation (JSONL) and narrate tool calls
# to stdout. Off by default — the run artifact is the durable output (PRD-2 §19).
# Worth enabling while the system is new.
INVESTIGATOR_TRACE=false
INVESTIGATOR_TRACE_DIR=runs/traces

# Character budget for a single query result (ADR 002, "result-size limits").
# One unbounded wide-table query serialises to ~88k tokens without this.
INVESTIGATOR_RESULT_MAX_CHARS=40000
