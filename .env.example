# Mock Sentinel REST facade (apps/mock-sentinel)
PORT=8787
HOST=0.0.0.0
SERVICE_VERSION=0.0.0-dev
LOG_LEVEL=info

# Kusto Emulator — INTERNAL dependency of Mock Sentinel.
# No consumer outside apps/mock-sentinel may talk to this endpoint (PRD-1 §7).
KUSTO_ENDPOINT=http://localhost:8080
KUSTO_PORT=8080
KUSTO_DATABASE=SentinelLab
KUSTO_TIMEOUT_MS=30000

# Upper bound on rows returned by POST /query before truncation is reported.
QUERY_MAX_ROWS=500

# --- Investigator (apps/investigator, PRD-2) ---------------------------------
# Validated at startup by apps/investigator/src/env.ts, so a missing required key
# stops the process before the first alert is fetched.

# Sentinel capability. Mock is the zero-credential default.
SENTINEL_CONNECTOR=mock
SENTINEL_BASE_URL=http://localhost:8787
SENTINEL_TIMEOUT_MS=30000

# Real Microsoft Sentinel through Azure Monitor Logs. Workspace ID is required
# when SENTINEL_CONNECTOR=azure. Set all three service-principal values, or omit
# all three and sign in first with `az login` or `Connect-AzAccount`. Use the
# Workspace ID (GUID), not its display name. Workspace shared keys cannot query.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_LOG_ANALYTICS_WORKSPACE_ID=

# Provider/model for the investigation agent. Registered providers: openai,
# anthropic, google, plus llamacpp when the complete endpoint group below is set.
# Override per run, e.g.
#   INVESTIGATOR_MODEL=gpt-5.6-sol bun run investigate --alert <id>
INVESTIGATOR_PROVIDER=openai
INVESTIGATOR_MODEL=gpt-5.6-luna
INVESTIGATOR_THINKING_LEVEL=medium

# One llama-server model exposed through its OpenAI-compatible API. Supply all
# four endpoint values or none. The URL must be absolute and end in /v1. Bearer
# authentication is optional; omit the token for a keyless endpoint.
# LLAMA_SERVER_BASE_URL=https://host.example/v1
# LLAMA_SERVER_MODEL=local-model
# LLAMA_SERVER_CONTEXT_WINDOW=65536
# LLAMA_SERVER_MAX_TOKENS=4096
# LLAMA_SERVER_BEARER_TOKEN=...

# Runtime guardrails, not investigation logic (PRD-2 §17).
INVESTIGATOR_MAX_TURNS=50
INVESTIGATOR_TIMEOUT_MS=600000

# Read by pi-ai from the ambient environment. Set the one matching your provider.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Public web research. Without BRAVE_API_KEY the agent still investigates on
# telemetry alone; web_search simply fails as a recoverable tool error.
BRAVE_API_KEY=
BRAVE_TIMEOUT_MS=15000
BRAVE_RESULT_COUNT=10
WEB_FETCH_TIMEOUT_MS=20000

# Where run artifacts are written. Azure runs must use an ignored .data/ path,
# for example .data/azure-runs, because they can contain tenant data.
RUNS_DIR=runs
# Analyst classifications; separate because they are not reproducible scratch data.
FEEDBACK_DIR=feedback

# Capture the full Pi transcript per investigation (JSONL) and narrate tool calls
# to stdout. Off by default — the run artifact is the durable output (PRD-2 §19).
# Worth enabling while the system is new.
INVESTIGATOR_TRACE=false
INVESTIGATOR_TRACE_DIR=runs/traces

# Character budget for a single query result (ADR 002, "result-size limits").
# One unbounded wide-table query serialises to ~88k tokens without this.
INVESTIGATOR_RESULT_MAX_CHARS=40000
