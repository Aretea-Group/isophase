# Isophase configuration for a clone. Copy this file to .env and fill in sections 1 and 2.
# (Installed the npm package instead? `isophase init` writes your .env for you.)
# Every uncommented value is the default. Everything else is optional.
# Full explanations: README.md and docs/defender-setup.md.

# ---- 1. Model (required) -----------------------------------------------------
# Providers: openai, anthropic, google, llamacpp.
INVESTIGATOR_PROVIDER=openai
INVESTIGATOR_MODEL=gpt-5.6-luna
INVESTIGATOR_THINKING_LEVEL=medium

# The API key for the provider above. Set the one you use.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Self-hosted model instead: INVESTIGATOR_PROVIDER=llamacpp and all four values.
# LLAMA_SERVER_BASE_URL=https://host.example/v1
# LLAMA_SERVER_MODEL=local-model
# LLAMA_SERVER_CONTEXT_WINDOW=65536
# LLAMA_SERVER_MAX_TOKENS=4096
# Reasoning profile: off | binary | effort
# LLAMA_SERVER_REASONING_PROFILE=off
# LLAMA_SERVER_BEARER_TOKEN=

# ---- 2. Security data source (pick one) -------------------------------------
# defender, sentinel, or both as a list: defender,sentinel
# sentinel is the local lab (Mock Sentinel) unless SENTINEL_CONNECTOR=azure below.
SECURITY_SOURCES=sentinel
# Only when SECURITY_SOURCES lists more than one: which source produces the alerts.
# PRIMARY_ALERT_SOURCE=defender

# Microsoft Defender XDR. Set all three; see docs/defender-setup.md.
# DEFENDER_TENANT_ID=
# DEFENDER_CLIENT_ID=
# DEFENDER_CLIENT_SECRET=
# How far back the alert queue looks (ISO 8601). Widen it on a quiet tenant.
DEFENDER_ALERT_WINDOW=P7D

# Microsoft Sentinel. mock = local lab. azure = a real Log Analytics workspace:
# set the workspace GUID, plus either all three service-principal values or
# none of them (then sign in with `az login` first).
SENTINEL_CONNECTOR=mock
# AZURE_LOG_ANALYTICS_WORKSPACE_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ---- 3. Web research (optional) ----------------------------------------------
# Without a key the agent investigates on telemetry alone.
BRAVE_API_KEY=

# ---- 4. Unattended loop: bun run investigate --watch ------------------------
WATCH_POLL_INTERVAL_MS=300000
# Overrides DEFENDER_ALERT_WINDOW while the loop runs.
WATCH_ALERT_WINDOW=PT6H
# Stop after spending this much. Set it before leaving the loop unattended.
# WATCH_SPEND_CEILING_USD=5.00
# Write findings as a comment on the incident. Needs SecurityIncident.ReadWrite.All too.
PUBLISH_FINDINGS=false
# Vendor status values to skip, e.g. resolved,closed. The loop prints what it saw.
WATCH_SKIP_STATUSES=

# ---- 5. Output ---------------------------------------------------------------
# Runs against a live tenant must use a path under .data/, e.g. .data/runs.
RUNS_DIR=runs
INVESTIGATOR_TRACE=false
INVESTIGATOR_TRACE_DIR=runs/traces

# ---- Advanced: defaults you rarely change ------------------------------------
SENTINEL_BASE_URL=http://localhost:8787
SENTINEL_TIMEOUT_MS=30000
DEFENDER_TIMEOUT_MS=30000
DEFENDER_QUERY_MAX_ROWS=500
# Targets one workspace onboarded to the Defender portal. An unknown id is
# silently answered from the primary workspace, so leave unset unless needed.
# DEFENDER_WORKSPACE_ID=
INVESTIGATOR_MAX_TURNS=50
INVESTIGATOR_TIMEOUT_MS=1200000
INVESTIGATOR_RESULT_MAX_CHARS=40000
INVESTIGATOR_TRACE_STREAM=false
BRAVE_TIMEOUT_MS=15000
BRAVE_RESULT_COUNT=10
WEB_FETCH_TIMEOUT_MS=20000
WATCH_WINDOW_INTERVAL_RATIO=3
WATCH_MAX_FAILURES_PER_ALERT=2
WATCH_BACKOFF_MAX_MS=900000
WATCH_CONTROL_SOCKET=runs/control.sock
CONSOLE_MAX_CONCURRENT_RUNS=2
BENCHMARK_MAP_PATH=fixtures/benchmark-map.generated.json
# Live smoke tests against a real tenant (bun test ...). Need the credentials above.
# DEFENDER_LIVE_TEST=true
# AZURE_SENTINEL_LIVE_TEST=true

# ---- Local lab only (Track B): Mock Sentinel and the Kusto emulator ----------
PORT=8787
HOST=0.0.0.0
SERVICE_VERSION=0.0.0-dev
LOG_LEVEL=info
KUSTO_ENDPOINT=http://localhost:8080
KUSTO_PORT=8080
KUSTO_DATABASE=SentinelLab
KUSTO_TIMEOUT_MS=30000
QUERY_MAX_ROWS=500
