# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Generated BAML client (regenerate with `bunx baml-cli generate`)
baml_client/

# Local scratch for the bootstrap loader. The Training Lab telemetry itself is
# vendored under fixtures/telemetry/ (MIT, pinned revision) — see that directory's
# SOURCE.md and docs/adr/001-training-lab-kusto.md.
.data/

# Local environment
.env
.env.local

# Local implementation plans use GitHub Issues; never commit root scratch plans.
/*-plan.md

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Investigation transcripts (PRD-3 §12). Optional, off by default, and 0.16–23 MB apiece.
#
# The run artifacts beside them are deliberately *not* ignored (PRD-6 §6.9, ADR 008 §8): a run costs
# real money against a non-deterministic model with no seed, so it is a measurement that cannot be
# re-derived, and a benchmark that cannot be reproduced from a fresh clone is not a benchmark.
# `runs/*.json` and `runs/.archive/*.json` are committed; only the transcripts stay local.
#
# Anchored to the repository root. Unanchored, this pattern matches any directory named `traces`
# at any depth — the same trap `/runs/` hit when it silently excluded the console's committed test
# fixtures (PRD-3 §12).
/runs/traces/

