# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Generated BAML client (regenerate with `bunx baml-cli generate`)
baml_client/

# Local scratch for the bootstrap loader. The Training Lab telemetry itself is
# vendored under fixtures/telemetry/ (MIT, pinned revision) — see that directory's
# SOURCE.md and docs/adr/001-training-lab-kusto.md.
.data/

# Local environment
.env
.env.local

# Local implementation plans use GitHub Issues; never commit root scratch plans.
/*-plan.md
/fix.md

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Run artifacts, their archive and their transcripts (ADR 012, reversing ADR 008 §8). An artifact
# is this checkout's measurement of its own agent and, against a live tenant, may carry tenant data;
# the repository ships the benchmark inputs under fixtures/ and nobody's results.
#
# Anchored to the repository root. Unanchored, `runs` matches any directory of that name at any
# depth and silently excludes the committed test fixtures under apps/*/test/fixtures/runs/ — the
# trap PRD-3 §12 hit once. scripts/run-artifacts-ignored.test.ts guards it.
/runs/
