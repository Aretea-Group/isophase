# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Generated BAML client (regenerate with `bunx baml-cli generate`)
baml_client/

# Local scratch for the bootstrap loader. The Training Lab telemetry itself is
# vendored under fixtures/telemetry/ (MIT, pinned revision) — see that directory's
# SOURCE.md and docs/adr/001-training-lab-kusto.md.
.data/

# Local environment
.env
.env.local

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Investigation run artifacts (PRD-2 §19). The durable output of a run, but local
# to a developer's experiments — regenerate with `bun run investigate`.
#
# Anchored to the repository root. Unanchored, this pattern matches any directory named `runs`
# at any depth, which silently excluded the console's committed test fixtures (PRD-3 §12).
/runs/

# Analyst classifications recorded by the console. Local operational data, not source.
/feedback/
