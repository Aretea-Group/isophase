{
  "name": "soc-agent-poc",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test",
    "dev:mock-sentinel": "bun --filter @soc/mock-sentinel dev",
    "investigate": "bun apps/investigator/src/index.ts",
    "evaluate": "bun scripts/evaluate-runs.ts",
    "console": "bun apps/console/src/index.ts",
    "data:bootstrap": "bun scripts/bootstrap-sentinel-data.ts",
    "data:reset": "bun scripts/bootstrap-sentinel-data.ts --reset",
    "data:verify": "bun scripts/bootstrap-sentinel-data.ts --verify-only",
    "data:manifest": "bun scripts/generate-telemetry-manifest.ts && bun scripts/generate-benchmark-map.ts",
    "queue:reset": "bun scripts/reset-queue.ts",
    "probe:defender": "bun scripts/probe-defender.ts",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@t3-oss/env-core": "0.13.11"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
